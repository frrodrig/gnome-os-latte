++void AtomispCameraData::imageBufferReady(FrameBuffer *buffer)
++{
++	Request *request = buffer->request();
++
++	if (!stopping_ && buffer->metadata().status == FrameMetadata::FrameSuccess) {
++		if (!frameIds_.contains(buffer)) {
++			LOG(Atomisp, Error) << "No IPA frame ID for completed buffer";
++			pipe()->cancelRequest(request);
++			return;
++		}
++		pendingStats_.push_back(buffer);
++		processPendingStats();
++		return;
++	}
++
++	frameIds_.erase(buffer);
++	pipe()->completeBuffer(request, buffer);
++	pipe()->completeRequest(request);
++}
++
++void AtomispCameraData::processPendingStats()
++{
++	if (stopping_ || statsInFlight_ || pendingStats_.empty())
++		return;
++
++	FrameBuffer *buffer = pendingStats_.front();
++	const uint32_t frame = frameIds_.at(buffer);
++	const ControlList sensorControls = delayedCtrls_->get(buffer->metadata().sequence);
++	if (!sensorControls.contains(V4L2_CID_EXPOSURE) ||
++	    !sensorControls.contains(V4L2_CID_ANALOGUE_GAIN)) {
++		LOG(Atomisp, Error) << "Sensor exposure or gain is unavailable";
++		pendingStats_.pop_front();
++		frameIds_.erase(buffer);
++		pipe()->cancelRequest(buffer->request());
++		processPendingStats();
++		return;
++	}
++	statsInFlight_ = true;
++	ipa_->computeParams(frame);
++	stats_->valid = false;
++	if (frame % 4 == 0) {
++		std::vector<DmaSyncer> syncers;
++		std::set<int> syncedFds;
++		for (const FrameBuffer::Plane &plane : buffer->planes()) {
++			if (syncedFds.insert(plane.fd.get()).second)
++				syncers.emplace_back(plane.fd, DmaSyncer::SyncType::Read);
++		}
++		MappedFrameBuffer mapped(buffer, MappedFrameBuffer::MapFlag::Read);
++		const StreamConfiguration &config = stream_.configuration();
++		if (mapped.isValid() && mapped.planes().size() == 3) {
++			std::array<latte::YuvPlane, 3> planes;
++			for (size_t i = 0; i < planes.size(); i++) {
++				const auto &plane = mapped.planes()[i];
++				planes[i] = { std::span<const uint8_t>(plane.data(), plane.size()),
++					      i == 0 ? config.stride : config.stride / 2 };
++			}
++			latte::YuvStats result;
++			if (latte::calculateYuv420Stats(planes, config.size.width, config.size.height,
++							 { 0, 0, config.size.width, config.size.height }, result)) {
++				stats_->yHistogram = result.histogram;
++				stats_->sum_ = RGB<uint64_t>({ result.red, result.green, result.blue });
++				stats_->valid = true;
++			}
++		}
++		if (!stats_->valid)
++			LOG(Atomisp, Error) << "Could not read YUV420 statistics from capture buffer";
++	}
++	ipa_->processStats(frame, 0, sensorControls);
++}
++
++void AtomispCameraData::metadataReady(uint32_t frame, const ControlList &metadata)
++{
++	if (stopping_ || !statsInFlight_ || pendingStats_.empty() ||
++	    frameIds_.at(pendingStats_.front()) != frame)
++		return;
++
++	FrameBuffer *buffer = pendingStats_.front();
++	pendingStats_.pop_front();
++	frameIds_.erase(buffer);
++	statsInFlight_ = false;
++	Request *request = buffer->request();
++	request->_d()->metadata().merge(metadata);
++	request->_d()->metadata().set(controls::SensorTimestamp, buffer->metadata().timestamp);
++	pipe()->completeBuffer(request, buffer);
++	pipe()->completeRequest(request);
++	processPendingStats();
++}
