++void AtomispCameraData::setSensorControls(const ControlList &sensorControls)
++{
++	if (stopping_)
++		return;
++	delayedCtrls_->push(sensorControls);
++	ControlList ctrls(sensorControls);
++	sensor_->setControls(&ctrls);
++}
